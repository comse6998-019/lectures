% Figure 16 of the notes (fig:dispatch-cycle), turned on its side for a slide: the notes draw the
% cycle top to bottom, which on a 4:3 page leaves no room for anything else. Same five operations
% and same three refusal branches, all rejoining at the observation the successful path produces,
% which is the point of the drawing. What state and the trace then do with that observation is the
% slide's closing line rather than a sixth node.
\begin{tikzpicture}[x=1cm, y=1cm, font=\small, text=navy,
  st/.style={rounded corners=4pt, draw=navy, line width=1pt, align=center,
             minimum width=3.4cm, minimum height=1.5cm, inner sep=4pt},
  mst/.style={st, fill=dblue!14},
  rst/.style={st, fill=black!7},
  term/.style={st, fill=white, dash pattern=on 3pt off 2pt},
  fl/.style={-{Stealth[length=2.8mm]}, line width=1.2pt, draw=navy},
  bk/.style={-{Stealth[length=2.6mm]}, line width=1pt, draw=navy, dashed},
  ev/.style={font=\footnotesize, align=center, inner sep=2.5pt, fill=white}]

  \def\sub#1{\\[-1pt]{\scriptsize\color{navy!70}#1}}

  \node[term] (req)  at (0,0)    {\textbf{tool request}\sub{name and arguments}};
  \node[rst]  (res)  at (4.4,0)  {\textbf{resolve}\sub{the name, in the registry}};
  \node[rst]  (bind) at (8.8,0)  {\textbf{bind}\sub{arguments to the signature}};
  \node[rst]  (pol)  at (13.2,0) {\textbf{check}\sub{the path, inside the root}};
  \node[mst]  (exec) at (17.6,0) {\textbf{execute}\sub{call the function}};

  \node[rst, minimum width=4.4cm] (obs) at (17.6,-3.6)
    {\textbf{observation}\sub{\texttt{ok}, result, arguments}};

  \draw[fl] (req)  -- (res);
  \draw[fl] (res)  -- (bind);
  \draw[fl] (bind) -- (pol);
  \draw[fl] (pol)  -- (exec);
  \draw[fl] (exec) -- node[ev, right] {result, or\\a tool error} (obs);

  \draw[bk] (res.south)  to[out=-90, in=175]
    node[ev, pos=0.22, below left, align=right] {not in the\\registry} (obs.west);
  \draw[bk] (bind.south) to[out=-90, in=160]
    node[ev, pos=0.3, below left, align=right] {arguments that\\do not bind} (obs.north west);
  \draw[bk] (pol.south)  to[out=-90, in=135]
    node[ev, pos=0.42, left, align=right] {outside\\the root} (obs.north west);
\end{tikzpicture}

% V0: four nodes, one kind of edge, no edge back. Blue is a model call, grey is runtime work.
\begin{tikzpicture}[x=1cm, y=1cm, font=\small, text=navy,
  nd/.style={rounded corners=4pt, draw=navy, line width=1pt, align=center,
             minimum width=3.3cm, minimum height=1.5cm, inner sep=4pt},
  mnode/.style={nd, fill=dblue!14},
  rnode/.style={nd, fill=black!7},
  term/.style={rounded corners=3pt, draw=navy, line width=0.9pt, fill=white, align=center,
               minimum width=1.7cm, minimum height=1.0cm},
  fl/.style={-{Stealth[length=2.8mm]}, line width=1.2pt, draw=navy},
  key/.style={font=\scriptsize, text=navy!75}]

  \def\sub#1{\\[-1pt]{\scriptsize\color{navy!70}#1}}

  \node[term]  (in)    at (0,0)    {Alert};
  \node[rnode] (loc)   at (3.1,0)  {\textbf{locate}\sub{one \texttt{read\_file}}};
  \node[mnode] (lines) at (7.0,0)  {\textbf{name the lines}\sub{one model call}};
  \node[mnode] (patch) at (10.9,0) {\textbf{write the patch}\sub{one model call}};
  \node[rnode] (sub)   at (14.8,0) {\textbf{Submit}\sub{three checks}};
  \node[term]  (out)   at (17.6,0) {Patch};

  \draw[fl] (in) -- (loc);
  \draw[fl] (loc) -- (lines);
  \draw[fl] (lines) -- (patch);
  \draw[fl] (patch) -- (sub);
  \draw[fl] (sub) -- (out);

  \node[key, anchor=west] at (3.1,-1.5) {grey: the runtime does it};
  \node[key, anchor=west] at (8.4,-1.5) {blue: the model fills in content};
\end{tikzpicture}

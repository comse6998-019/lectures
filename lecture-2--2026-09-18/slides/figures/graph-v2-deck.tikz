% The graph lec2_planning_and_validation_agent compiles, folded into two rows so it
% fills a slide rather than running as a thin strip.
% Five nodes. Solid edges are the two unconditional add_edge calls; dashed edges carry
% a predicate. Read from demo/lec2_planning_and_validation_agent/graph.py, compile().
\begin{tikzpicture}[x=1cm, y=1cm, font=\small, text=navy,
  st/.style={rounded corners=4pt, draw=navy, line width=1pt, align=center,
             minimum width=3.7cm, minimum height=1.45cm, inner sep=4pt},
  mst/.style={st, fill=dblue!14},
  rst/.style={st, fill=black!7},
  fl/.style={-{Stealth[length=2.8mm]}, line width=1.2pt, draw=navy},
  bk/.style={-{Stealth[length=2.6mm]}, line width=1pt, draw=navy, dashed},
  ev/.style={font=\footnotesize, align=center, inner sep=2.5pt, fill=white}]

  \def\sub#1{\\[-1pt]{\scriptsize\color{navy!70}#1}}
  \def\by#1{\\[-1pt]{\scriptsize\color{navy!65}by the #1}}

  \node[circle, fill=navy, inner sep=2.4pt] (start) at (-3.2,0) {};
  \node[font=\footnotesize\bfseries, above=3pt of start] {Start};

  \node[mst] (plan)  at (0,0)      {\textbf{plan}\sub{propose or revise subgoals}};
  \node[rst] (tools) at (6.0,3.5)  {\textbf{tools}\sub{validate, execute, observe}};
  \node[mst] (ctrl)  at (6.0,0)    {\textbf{controller}\sub{one model call}};
  \node[rst] (sub)   at (6.0,-3.5) {\textbf{submit}\sub{three checks, no verdict}};
  \node[mst] (val)   at (12.4,-3.5){\textbf{validate}\sub{the only node that accepts}};
  \node[circle, draw=navy, line width=1pt, inner sep=3.2pt] (end) at (16.2,-3.5)
        {\tikz\node[circle, fill=navy, inner sep=2.2pt]{};};
  \node[font=\footnotesize\bfseries, above=3pt of end] {End};

  % the two unconditional edges: a run begins at the planner and ends at the judge
  \draw[fl] (start) -- (plan);
  \draw[fl] (val) -- node[ev]{a verdict} (end);

  \draw[bk] (plan) -- node[ev]{the plan} (ctrl);

  % the inner loop
  \draw[bk] (ctrl.north west) to[bend left=28]
        node[ev, left=1pt, pos=0.55]{tool call\by{model}} (tools.south west);
  \draw[bk] (tools.south east) to[bend left=28]
        node[ev, right=1pt, pos=0.45]{observation} (ctrl.north east);

  % the edge V1 did not have: a stalled run gets its plan replaced before it is abandoned
  \draw[bk] (tools.north west) to[out=155, in=95, looseness=1.0]
        node[ev, pos=0.68, above]{nothing new came back\by{runtime}} (plan.north);

  % down to the checks, and back up when they fail
  \draw[bk] (ctrl.south west) to[bend right=14]
        node[ev, left=1pt, pos=0.5]{no tool call\by{model}} (sub.north west);
  \draw[bk] (sub.north east) to[bend right=14]
        node[ev, right=1pt, pos=0.5]{checks failed\sub{reasons returned}} (ctrl.south east);

  \draw[bk] (sub) -- node[ev]{checks passed\by{runtime}} (val);
\end{tikzpicture}

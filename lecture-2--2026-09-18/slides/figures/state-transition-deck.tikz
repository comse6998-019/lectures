% Figure 12 of the notes (fig:state-transition), redrawn for a slide: wider nodes, a sub-line on
% each, and the reducer's two arguments named on the edges that carry them.
% Solid edges are the path an update travels; the dashed arc is the reducer's left argument, which
% comes from the current state and never from the node.
\begin{tikzpicture}[x=1cm, y=1cm, font=\small, text=navy,
  st/.style={rounded corners=4pt, draw=navy, line width=1pt, align=center,
             minimum width=3.4cm, minimum height=1.8cm, inner sep=4pt},
  mst/.style={st, fill=dblue!14},
  rst/.style={st, fill=black!7},
  ext/.style={st, fill=white, draw=navy, dash pattern=on 3pt off 2pt, minimum width=5.2cm},
  fl/.style={-{Stealth[length=2.8mm]}, line width=1.2pt, draw=navy},
  bk/.style={-{Stealth[length=2.6mm]}, line width=1pt, draw=navy, dashed},
  ev/.style={font=\footnotesize, align=center, inner sep=2.5pt, fill=white}]

  \def\sub#1{\\[-1pt]{\scriptsize\color{navy!70}#1}}

  \node[rst] (s0)  at (0,0)    {\textbf{state $s_t$}\sub{before the step}};
  \node[mst] (nd)  at (4.6,0)  {\textbf{node}\sub{reads state and the result}};
  \node[rst] (upd) at (9.2,0)  {\textbf{partial update $u_t$}\sub{only the keys it touched}};
  \node[rst] (red) at (14.6,0) {\textbf{reducer}\sub{one per key}};
  \node[rst] (s1)  at (19.2,0) {\textbf{state $s_{t+1}$}\sub{after the merge}};

  \node[ext] (e) at (4.6,-3.4) {\textbf{model reply or tool observation $e_t$}%
    \sub{arrives from outside the program}};

  \draw[fl] (s0)  -- (nd);
  \draw[fl] (nd)  -- (upd);
  \draw[fl] (upd) -- node[ev, below=1pt] {right\\argument} (red);
  \draw[fl] (red) -- (s1);
  \draw[fl] (e)   -- (nd);

  \draw[bk] (s0.north) to[out=60, in=120]
    node[ev, above] {left argument} (red.north);
\end{tikzpicture}

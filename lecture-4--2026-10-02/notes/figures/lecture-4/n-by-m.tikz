% Why native tool calling does not interoperate: with one integration per application and tool pair, N
% applications and M tools need N x M integrations; a shared protocol needs N + M.
\definecolor{deckNavy}{HTML}{28285E}
\begin{tikzpicture}[
  ttl/.style={font=\sffamily\bfseries\small, text=deckNavy},
  cnt/.style={font=\sffamily\footnotesize, text=deckNavy},
  link/.style={draw=ibmfg!55, thick}
]
  % N x M: every application is wired to every tool
  \node[ttl] at (2.1,2.45) {N $\times$ M integrations};
  \foreach \i in {0,1,2} { \node[mnode, minimum width=17mm] (a\i) at (0,1.5-\i*1.2) {app \the\numexpr\i+1\relax}; }
  \foreach \j in {0,1,2} { \node[rnode, minimum width=17mm] (t\j) at (4.2,1.5-\j*1.2) {tool \the\numexpr\j+1\relax}; }
  \foreach \i in {0,1,2} { \foreach \j in {0,1,2} { \draw[link] (a\i) -- (t\j); } }
  \node[cnt] at (2.1,-1.35) {nine integrations};

  % N + M: every application and tool speaks one protocol
  \node[ttl] at (10.6,2.45) {N $+$ M integrations};
  \foreach \i in {0,1,2} { \node[mnode, minimum width=17mm] (b\i) at (7.9,1.5-\i*1.2) {app \the\numexpr\i+1\relax}; }
  \node[draw=deckNavy, thick, rounded corners=2pt, fill=deckNavy!10, font=\sffamily\footnotesize\bfseries,
    minimum width=17mm, minimum height=30mm, text=deckNavy, align=center] (p) at (10.6,0.3) {shared\\protocol};
  \foreach \j in {0,1,2} { \node[rnode, minimum width=17mm] (u\j) at (13.3,1.5-\j*1.2) {tool \the\numexpr\j+1\relax}; }
  \foreach \i in {0,1,2} { \draw[link] (b\i) -- (p.west |- b\i); }
  \foreach \j in {0,1,2} { \draw[link] (p.east |- u\j) -- (u\j); }
  \node[cnt] at (10.6,-1.35) {six integrations};
\end{tikzpicture}

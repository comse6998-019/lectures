% Two limits of native tool calling. Left: a task that edits only the files where a match sits inside a loop
% needs one model turn per decision, and every result enters the context; a script makes the decisions in
% one turn and prints a summary. Right: each application integrates each tool itself.
\definecolor{deckNavy}{HTML}{28285E}
\begin{tikzpicture}[
  turn/.style={mnode, minimum width=24mm, minimum height=6mm, font=\sffamily\scriptsize},
  ctx/.style={font=\sffamily\scriptsize, text=ibmfg!75, anchor=west},
  head/.style={font=\sffamily\footnotesize\bfseries, text=deckNavy},
  link/.style={draw=ibmfg!55, thick}
]
  % limit 1, native calls
  \node[head] at (1.2,2.55) {limit 1: native calls};
  \node[turn] (t1) at (0,1.8) {turn 1: search};
  \node[ctx] at (1.35,1.8) {40 matches enter the context};
  \node[turn] (t2) at (0,1.0) {turn 2: 40 read\_file};
  \node[ctx] at (1.35,1.0) {40 files enter the context};
  \node[turn] (t3) at (0,0.2) {turn 3: 12 edits};
  \node[ctx] at (1.35,0.2) {12 results enter the context};
  \node[turn] (t4) at (0,-0.6) {turn 4: answer};
  \draw[flow] (t1) -- (t2); \draw[flow] (t2) -- (t3); \draw[flow] (t3) -- (t4);

  % limit 1, one script
  \node[head] at (1.2,-1.45) {the same task as one script};
  \node[turn] (s1) at (0,-2.2) {turn 1: script};
  \node[ctx] at (1.35,-2.2) {prints ``edited 12 files''};
  \node[turn] (s2) at (0,-3.0) {turn 2: answer};
  \draw[flow] (s1) -- (s2);

  \draw[densely dotted, draw=ibmfg!40] (6.3,2.8) -- (6.3,-3.4);

  % limit 2: N x M
  \node[head] at (9.4,2.55) {limit 2: integration};
  \foreach \i in {0,1,2} { \node[mnode, minimum width=15mm, font=\sffamily\scriptsize] (a\i) at (7.6,1.6-\i*1.3) {app \the\numexpr\i+1\relax}; }
  \foreach \j in {0,1,2} { \node[rnode, minimum width=15mm, font=\sffamily\scriptsize] (u\j) at (11.2,1.6-\j*1.3) {tool \the\numexpr\j+1\relax}; }
  \foreach \i in {0,1,2} { \foreach \j in {0,1,2} { \draw[link] (a\i) -- (u\j); } }
  \node[font=\sffamily\scriptsize, text=ibmfg!75, align=center] at (9.4,-2.4) {each line is glue code written\\for one application and one tool};
\end{tikzpicture}

\begin{tikzpicture}[node distance=7mm, every node/.append style={text=ibmfg}]
  \node[rnode, text width=62mm] (n0) {workload environment: GITHUB\_TOKEN = opaque\\reference};
  \node[rnode, text width=62mm, below=of n0] (n1) {client builds HTTP request};
  \draw[flow] (n0) -- (n1);
  \node[mnode, text width=62mm, below=of n1] (n2) {network policy admits caller + destination\\+ request};
  \draw[flow] (n1) -- (n2);
  \node[mnode, text width=62mm, below=of n2] (n3) {credential binding admits host + port +\\path};
  \draw[flow] (n2) -- (n3);
  \node[mnode, text width=62mm, below=of n3] (n4) {supervisor substitutes real credential};
  \draw[flow] (n3) -- (n4);
  \node[rnode, text width=62mm, below=of n4] (n5) {authorized upstream service};
  \draw[flow] (n4) -- (n5);
\end{tikzpicture}

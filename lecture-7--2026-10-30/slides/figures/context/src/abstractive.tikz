% Abstractive compaction: a summary replaces the history (Slides 7.3 and 7.4c).
% Canvas: 16.5 x 6.2 cm. Four stages.

% Stage 1: reveal the history: five messages and tool results, 60k tokens.
% Stage 2: reveal the summarizer and its 40-token summary. Fade the history.
% Stage 3: reveal the next request: system prompt, summary, and recent messages.
% Stage 4: reveal the omitted order in rose and the source check in navy.

% The messages and token counts are illustrative. The pattern follows Anthropic's 2025 context engineering article.
% The narrow exceptions below preserve TikZ command syntax.

% <!-- ste-disable-next-line dictionary-not-approved-word -->
\begin{tikzpicture}

  \canvas{16.5}{6.2}

  \tikzset{msg/.style={slot, text width=40mm, anchor=north west}}

  % <!-- ste-disable-next-line semicolon -->
  \node[capt, anchor=south west] at (0.2,5.85) {the history: 60k tokens};

  \newcommand{\history}[1]{

    % <!-- ste-disable-next-line semicolon -->
    \node[msg, #1] (m1) at (0.2,5.75) {user: keep SKU-A stocked};

    % <!-- ste-disable-next-line semicolon -->
    \node[msg, #1] (m2) at ([yshift=-1.2mm]m1.south west) {tool, ledger Day 1: 10 SKU-A\\ ordered, paid, due Day 4};

    % <!-- ste-disable-next-line semicolon -->
    \node[msg, #1] (m3) at ([yshift=-1.2mm]m2.south west) {assistant: wait for delivery};

    % <!-- ste-disable-next-line semicolon -->
    \node[msg, #1] (m4) at ([yshift=-1.2mm]m3.south west) {tool, log Day 2: shelf empty};

    % <!-- ste-disable-next-line semicolon -->
    \node[msg, #1] (m5) at ([yshift=-1.2mm]m4.south west) {tool, log Day 3: shelf empty};

  }

  \beforestage{2}{\history{}}

  \atstage{2}{\history{faded}}

  % Stage 2: the summarizer writes the summary.

  % <!-- ste-disable-next-line semicolon -->
  \onlystage{1}{\node[ghostbox, minimum width=36mm, minimum height=10mm, text=ibmfg!50, font=\sffamily\small] (sm) at (7.6,4.5) {summarizer};}

  \atstage{2}{

    % <!-- ste-disable-next-line semicolon -->
    \node[mnode, text width=32mm, align=center] (sm) at (7.6,4.5) {\textbf{summarizer}\\ an LLM writes a shorter account};

    % <!-- ste-disable-next-line semicolon -->
    \draw[flow] (4.55,4.5) -- (sm.west);

    % <!-- ste-disable-next-line semicolon -->
    \node[evnum] at (5.2,4.5) {1};

    % <!-- ste-disable-next-line semicolon -->
    \node[lab, fill=none, anchor=south] at (5.2,4.78) {reads 60k};

    % <!-- ste-disable-next-line semicolon -->
    \node[okchip, anchor=west, text width=46mm] (sum) at (10.7,4.5) {\textbf{summary, 40 tokens}\\ SKU-A is out of stock and the agent waits for stock.};

    % <!-- ste-disable-next-line semicolon -->
    \draw[flow] (sm.east) -- (sum.west);

    % <!-- ste-disable-next-line semicolon -->
    \node[evnum] at (10.05,4.5) {2};

    % <!-- ste-disable-next-line semicolon -->
    \node[lab, fill=none, anchor=south] at (10.05,4.78) {writes};

  }

  % Stage 3: stack the request slots by their actual edges, then fit the panel.

  \atstage{3}{

    % <!-- ste-disable-next-line semicolon -->
    \node[slot, anchor=north west, text width=46mm] (q1) at (10.85,2.75) {system prompt and tools};

    % <!-- ste-disable-next-line semicolon -->
    \node[slot, anchor=north west, text width=46mm, draw=deckNavy, line width=0.8pt] (q2) at ([yshift=-1.2mm]q1.south west) {the summary};

    % <!-- ste-disable-next-line semicolon -->
    \node[slot, anchor=north west, text width=46mm] (q3) at ([yshift=-1.2mm]q2.south west) {recent messages: Day 3 onward};

    % <!-- ste-disable-next-line dictionary-not-approved-word -->
    \begin{scope}[on background layer]

      % <!-- ste-disable-next-line semicolon -->
      \node[mnode, inner sep=3mm, fit={(q1) (q2) (q3)}] (req) {};

    \end{scope}

    % <!-- ste-disable-next-line semicolon -->
    \node[tab] (reqtab) at (req.north) {the next request};

    % <!-- ste-disable-next-line semicolon -->
    \draw[flow] (sum.south) -- (sum.south |- reqtab.north);

    % <!-- ste-disable-next-line semicolon -->
    \node[evnum] at ($(sum.south)!0.5!(sum.south |- reqtab.north)$) {3};

    % <!-- ste-disable-next-line semicolon -->
    \node[lab, fill=none, anchor=west] at ($(sum.south)!0.5!(sum.south |- reqtab.north)+(0.3,0)$) {replaces the history};

  }

  % Stage 4: check the summary against its source.

  \atstage{4}{

    % <!-- ste-disable-next-line semicolon -->
    \node[badverd, text width=44mm, align=center] at (7.6,2.55) {omitted: the paid order\\ and its due date};

    % <!-- ste-disable-next-line semicolon -->
    \pic[color=deckRose] at ($(sum.east)+(-0.25,0.42)$) {xmark};

    % <!-- ste-disable-next-line semicolon -->
    \node[verd, text width=44mm, align=center] at (7.6,1.45) {a summary is a new claim:\\ check it against the source};

  }

  % <!-- ste-disable-next-line semicolon -->
  \node[note, anchor=south west, inner sep=0pt] (citation) at (0.2,0.1) {messages and token counts illustrative. The pattern follows Anthropic's 2025 article on context engineering.};

\end{tikzpicture}

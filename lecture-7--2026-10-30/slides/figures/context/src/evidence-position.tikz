% evidence-position: the same answer document moved through a long input (Lost in the Middle, Liu et al., TACL 2024).
% Canvas 16.5 x 5.6 cm. Three stages. The paper's setting: multi-document question answering, the answer in one of k
% retrieved documents, with the position of that document varied. The figure draws the shape of the finding and no values.
% Stage 1: reveal the frame and the first row. The frame is the question, the kicker, the scope note and the source note. The answer document is the first of 20, and the reported accuracy is high.
% Stage 2: reveal the second row: the answer document sits in the middle. The reported accuracy is lowest there (rose).
% Stage 3: reveal the third row: the answer document is last, and the accuracy is high again. The navy caption under the rows names what stays fixed: the same 20 documents, the same question.
% Strings: the question is the course's vending example. The verdicts follow the pattern the paper reports for the models
% and prompts it tested: accuracy is often highest with the answer document first or last, and lowest in the middle.
% Illustrative, not from a source: the document count of 20 for all three rows (the paper also runs 10 and 30) and the question.
% Left out on purpose: every number, the paper's key-value retrieval task, and prompt order (the paper puts the question
% after the documents, so the question's place here says nothing about where it sits in the prompt).
\begin{tikzpicture}
  \canvas{16.5}{5.6}
  \tikzset{
    doc/.style={draw=ibmfg!40, fill=black!6, rounded corners=1pt, minimum width=3.4mm, minimum height=5mm, inner sep=0pt},
    hit/.style={doc, draw=deckNavy, fill=deckNavy, text=white, font=\sffamily\footnotesize\bfseries},
    rowlab/.style={font=\sffamily\small\bfseries, text=deckNavy, anchor=base east, inner sep=0pt},
    rowverd/.style={anchor=base west, inner sep=0pt},
  }
  % the columns: the question box and the row labels end at about 3.3, the documents run from 3.65 to 13.42,
  % the verdicts end at 16.3
  \def\xD{3.82}%    centre of document 1
  \def\dx{0.4964}%  pitch of the documents
  \def\xV{14.172}%  left edge of the verdicts
  \def\yT{5.142}%   baseline of the top line, level with the question's first line
  % the question box hugs its lines with 4 pt on every side. flush left: no hyphenation.
  % frenchspacing: no extra space after the colon. The row labels end at its right edge.
  \node[slot, anchor=north west, align=flush left, inner ysep=4pt,
        font=\sffamily\footnotesize\frenchspacing] (q) at (0.2,5.5)
    {\textbf{question:} which order\\ is due on Day 4?};
  \node[kick, anchor=base west] at (3.65,\yT) {the model reads all 20 documents, then answers};
  \node[note, anchor=base east, inner sep=0pt] at (16.3,\yT) {shape of the finding, no values};
  % \docrow{y}{hit}: twenty documents centred at height y, the answer document at position hit
  \newcommand{\docrow}[2]{%
    \foreach \i in {1,...,20}{%
      \pgfmathsetmacro{\x}{\xD+(\i-1)*\dx}%
      \ifnum\i=#2 \node[hit] at (\x,#1) {A};\else \node[doc] at (\x,#1) {};\fi
    }%
    \draw[flow] (13.622,#1) -- (14.022,#1);%
  }
  % stage 1: first
  \node[rowlab] at (q.east |- 0,4.02) {answer first};
  \docrow{4.1}{1}
  \node[verd, rowverd] at (\xV,4.02) {accuracy high};
  % stage 2: middle
  \atstage{2}{
    \node[rowlab] at (q.east |- 0,2.82) {answer in the middle};
    \docrow{2.9}{10}
    \node[badverd, rowverd] at (\xV,2.82) {accuracy lowest};
  }
  % stage 3: last
  \atstage{3}{
    \node[rowlab] at (q.east |- 0,1.62) {answer last};
    \docrow{1.7}{20}
    \node[verd, rowverd] at (\xV,1.62) {accuracy high};
    \node[capt, anchor=base west] at (3.65,0.9) {the same 20 documents, the same question, three positions of the answer};
  }
  \node[note, anchor=south west, inner sep=0pt] at (0.2,0.1) {Liu et al. 2024, multi-document QA, for the models and prompts they tested. The question is the course's example.};
\end{tikzpicture}

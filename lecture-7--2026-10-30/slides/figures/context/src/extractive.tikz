% extractive: a token classifier keeps or drops each token of the source (LLMLingua-2, Pan et al., Findings of ACL 2024;
% Slides 7.2 and 7.4b). Canvas 16.5 x 6.6 cm. Four stages.
% Stage 1: reveal the source line as eleven tokens.
% Stage 2: reveal the classifier and its label under each token: keep (navy tick) or drop (grey cross).
% Stage 3: reveal the compressed input, the kept tokens in order. The dropped tokens fade in the source row.
% Stage 4: reveal the check: one dropped word flipped the meaning (rose), so test the compressed input on the task (navy).
% Illustrative, not from a source: the line, the labels and the dropped word. LLMLingua-2 trains its classifier on data
% distilled from GPT-4 and reads both sides of each token; it reports task scores with the compression ratio and latency.
\begin{tikzpicture}
  \canvas{16.5}{6.6}
  \def\yt{5.85}      % the source tokens
  \def\ym{5.25}      % the labels under them
  \def\yo{2.35}     % the compressed input
  \node[kick, anchor=south west] at (0.3,6.2) {the source line, eleven tokens};
  \node[note, anchor=north east, inner sep=0pt] at (16.4,6.52) {illustrative labels};
  % the source tokens: drop tokens fade from stage 3 on
  \newcommand{\droptok}[3]{\beforestage{3}{\node[tok, #1] (#2) {#3};}\atstage{3}{\node[drop, #1] (#2) {#3};}}
  \node[tok, anchor=west] (t1) at (0.3,\yt) {ordered};
  \node[tok, right=1.5mm of t1] (t2) {10};
  \node[tok, right=1.5mm of t2] (t3) {SKU-A};
  \droptok{right=1.5mm of t3}{t4}{,}
  \node[tok, right=1.5mm of t4] (t5) {paid};
  \droptok{right=1.5mm of t5}{t6}{,}
  \node[tok, right=1.5mm of t6] (t7) {due};
  \node[tok, right=1.5mm of t7] (t8) {Day};
  \node[tok, right=1.5mm of t8] (t9) {4};
  \droptok{right=1.5mm of t9}{t10}{unless}
  \node[tok, right=1.5mm of t10] (t11) {cancelled};
  % stage 2: the classifier labels each token
  \atstage{2}{
    \foreach \t in {t1,t2,t3,t5,t7,t8,t9,t11}{ \pic[color=deckNavy] at ($(\t.south)+(0,-0.3)$) {tick}; }
    \foreach \t in {t4,t6,t10}{ \pic[color=ibmfg!45] at ($(\t.south)+(0,-0.3)$) {xmark}; }
    \node[mnode, text width=58mm, align=center] (cls) at (8.25,3.85) {\textbf{token classifier} (LLMLingua-2)\\ keep or drop each token, reading the words on both sides};
    \draw[flow] (cls.north) -- (8.25,\ym-0.2);
    \node[evnum] at (8.25,4.82) {1};
    \node[lab, fill=none, anchor=west] at (8.55,4.82) {labels each token};
  }
  % stage 3: the compressed input
  \atstage{3}{
    \node[keep, anchor=west] (k1) at (4.1,\yo) {ordered};
    \node[keep, right=1.5mm of k1] (k2) {10};
    \node[keep, right=1.5mm of k2] (k3) {SKU-A};
    \node[keep, right=1.5mm of k3] (k4) {paid};
    \node[keep, right=1.5mm of k4] (k5) {due};
    \node[keep, right=1.5mm of k5] (k6) {Day};
    \node[keep, right=1.5mm of k6] (k7) {4};
    \node[keep, right=1.5mm of k7] (k8) {cancelled};
    \draw[flow] (cls.south) -- (8.25,\yo+0.3);
    \node[evnum] at (8.25,2.87) {2};
    \node[lab, fill=none, anchor=east] at (7.95,2.87) {compressed: eight tokens};
    \node[kick, anchor=east] at (3.9,\yo) {kept, in order};
  }
  % stage 4: the check
  \atstage{4}{
    \pic[color=deckRose] at ($(k8.north east)+(0.05,0.05)$) {xmark};
    \node[badverd, anchor=west] at (4.1,1.5) {one dropped word flipped the meaning: the order now reads as cancelled};
    \node[verd, anchor=west] at (4.1,1.0) {test the compressed input on the task it must serve, as the paper does};
  }
  \node[note, anchor=south west, inner sep=0pt] at (0.3,0.1) {Pan et al. 2024 report task scores with compression and latency. The line is the course's example.};
\end{tikzpicture}

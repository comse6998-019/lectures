% harness-formats: what Pi, Claude Code and Codex keep at compaction (Slides 7.5a to 7.5d). Canvas 16.5 x 6.6 cm.
% Four stages, one column per harness, then the common core.
% Stage 1: reveal Pi: a summary with fixed sections, the recent messages kept, the file lists carried forward.
% Stage 2: reveal Claude Code: a structured summary, up to five recent files read again, hooks and skills re-injected.
% Stage 3: reveal Codex: a handoff summary for the next model, with the tool state retained.
% Stage 4: reveal the common core: every column leads with an abstractive, structured summary (navy frames),
%          and each adds its own second move.
% Sources, read 2026-11-04: Pi docs/compaction.md; Claude Code docs, context-window; openai/codex
% codex-rs/prompts/templates/compact. Defaults can change; see part-02-harness-compaction.md.
\begin{tikzpicture}
  \canvas{16.5}{6.6}
  \tikzset{
    col/.style={mnode, inner sep=3mm},
    sumbox/.style={okchip, anchor=north west, text width=43mm},
    second/.style={slot, anchor=north west, text width=43mm},
    src/.style={font=\sffamily\scriptsize, text=deckGrey, anchor=north west, inner sep=0pt},
  }
  \def\gap{0.25}
  % \column{k}{x}{title}{summary}{second}{third}{source}: the boxes stack with one gap, the panel fits them
  \newcommand{\column}[7]{
    \node[sumbox] (s#1) at (#2,5.75) {#4};
    \node[second] (p#1) at ($(s#1.south west)+(0,-\gap)$) {#5};
    \node[second] (q#1) at ($(p#1.south west)+(0,-\gap)$) {#6};
    \node[src] (r#1) at ($(q#1.south west)+(0,-\gap)$) {#7};
    \begin{scope}[on background layer]
      \node[col, fit={(s#1) (p#1) (q#1) (r#1) (#2,0.75)}] (c#1) {};
    \end{scope}
    \node[tab] at (c#1.north) {#3};
  }
  % stage 1: Pi
  \column{1}{0.45}{Pi}
    {\textbf{summary, fixed sections}\\ Goal, Constraints and Preferences, Progress (Done, In Progress, Blocked), Key Decisions, Next Steps, Critical Context}
    {\textbf{plus} the recent messages, kept verbatim (\texttt{keepRecentTokens}, 20k by default)}
    {\textbf{plus} file lists carried forward: \texttt{readFiles}, \texttt{modifiedFiles}}
    {docs/compaction.md}
  % stage 2: Claude Code
  \atstage{2}{
    \column{2}{5.9}{Claude Code}
      {\textbf{structured summary}\\ of the conversation, written by the model, on \texttt{/compact} or as the window fills}
      {\textbf{plus} up to five recently touched files, read again (over 5000 tokens: a path only)}
      {\textbf{plus} hook output and skill text re-injected, large reads left to subagents}
      {docs: context-window}
  }
  % stage 3: Codex
  \atstage{3}{
    \column{3}{11.35}{Codex}
      {\textbf{context checkpoint compaction}\\ a handoff for the next model: progress and key decisions, context and preferences, next steps, critical data and references}
      {\textbf{plus} the state of the tools the previous model used, retained}
      {\textbf{plus} checkpoints and resume metadata, a separate memories pipeline}
      {codex-rs/prompts/templates/compact}
  }
  % stage 4: the common core
  \atstage{4}{
    \foreach \k in {1,2,3}{ \draw[hl] ($(s\k.south west)+(-0.08,-0.08)$) rectangle ($(s\k.north east)+(0.08,0.08)$); }
    \node[capt, inner sep=0pt] at (8.25,0.2) {one core in all three: an abstractive, structured summary. each adds its own second move.};
  }
  \node[note, anchor=north east, inner sep=0pt] at (16.4,6.55) {sources read 2026-11-04, defaults can change};
\end{tikzpicture}

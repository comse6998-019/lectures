% one-call: what one model call receives, what its decision needs, and what the whole run costs (Slide 5.1).
% Canvas 16.5 x 5.75 cm. Three stages, in the manner of lecture 5's context-poisoning and cost-harvesting figures.
% Stage 1: reveal the records that exist and the call's context: instructions, history, the selected ledger line, the window meter.
% Stage 2: reveal the call: the model decides the next action, which needs the paid order, its meaning intact and a route to the ledger.
% Stage 3: reveal the run meter: the context is sent again on every call, so the tokens billed add up across the run.
% Ghosts reserve the model and the run meter on stages 1 and 2. The selected chip is navy on stage 1 and grey from stage 2 on,
% when the three needs arrive in navy. The band and the panel share their top and bottom edges, their rows share one height and
% a 2 mm gap, and each frame has 2 mm of padding on every side (measured under the tab at the top). The run meter starts under
% the panel's left edge, so the gap between its label box and the bar matches the gap between the band and the panel.
% Illustrative, not from a source: the records, the token numbers and the number of calls. The window meter is drawn to scale
% (80k of 128k). The run meter has equal steps because the same context goes out on every call. The task is the Vending-Bench
% vending business (Andon Labs, 2025); the ledger and log lines are the course's teaching case, with the empty shelf on Days 2
% and 3 as in dropped-order and structured-notes. Left out on purpose: time and charges, which the speaker notes carry, and a
% label on connector 1, whose target already opens with "selected:".
\begin{tikzpicture}
  \frenchspacing  % one space after a colon
  \canvas{16.5}{5.75}
  \def\yT{5.5}                    % top edge of the band and the panel; both tabs sit on it
  \def\xP{4.796}                  % left edge of the panel and of the run meter, 8 mm right of the band
  \def\xV{4.396}                  % connector 1 runs down the middle of that gap
  \def\yMlo{0.45}\def\yMhi{0.95}  % the run meter
  \def\xMe{12.73}                 % its right end, 3 mm left of the verdict
  \tikzset{
    row/.style={anchor=north west, align=flush left, font=\sffamily\footnotesize, inner ysep=2pt, minimum height=7.6mm},
    rec/.style={rnode, row, text width=33mm},
    cslot/.style={gnode, row, text width=39.2mm},
    call/.style={minimum width=12mm, minimum height=9.5mm},
    need/.style={gnode, anchor=north, text width=27.5mm, align=flush center, font=\sffamily\footnotesize, inner ysep=2pt,
                 minimum height=5.5mm, draw=deckNavy, line width=1pt, outer sep=0.2pt},
    bold/.style={font=\sffamily\footnotesize\bfseries, inner sep=0pt},
    tick lab/.style={font=\sffamily\footnotesize, inner sep=0pt, anchor=base},
    meter box/.style={gnode, font=\sffamily\footnotesize, text width=37mm, align=flush center, inner ysep=2pt,
                      minimum height=5mm, anchor=west},
  }
  % ---- the records that exist: the left band, four rows 2 mm apart
  \node[rec] (ledger) at (0.2,\yT-0.41) {\texttt{inventory-ledger}, Day 1\\ 10 SKU-A paid, due Day 4};
  \node[rec] (log) at ([yshift=-2mm]ledger.south west) {\texttt{ops-log}, Days 2 and 3\\ shelf empty, no sales};
  \node[rec] (fees) at ([yshift=-2mm]log.south west) {\texttt{fees-and-prices}\\ the daily fee, the price list};
  \node[ghost, row, text width=33mm] (old) at ([yshift=-2mm]fees.south west) {older sessions: outside};
  \path (ledger.east) ++(0.2,0) coordinate (bandE) (old.south) ++(0,-0.2) coordinate (bandS);
  \begin{scope}[on background layer]
    \fill[band] (0,0 |- bandS) rectangle (bandE |- 0,\yT);
  \end{scope}
  \node[tab] at ($(0,\yT)!0.5!(bandE |- 0,\yT)$) {the records that exist};
  % ---- the call's context: the blue panel, its rows level with the records
  \node[cslot] (r1) at (\xP+0.2,\yT-0.41) {\textbf{instructions:} the system\\ prompt and the tool definitions};
  \node[cslot] (r2) at ([yshift=-2mm]r1.south west) {\textbf{history:} the messages and\\ tool results so far};
  \ifnum\stage<2 \def\chipink{deckNavy}\else\def\chipink{ibmfg!60}\fi  % the selection settles once the call arrives
  \node[cslot, draw=\chipink, line width=1pt, outer sep=0.2pt] (r3) at ([yshift=-2mm]r2.south west)
    {\textbf{selected:} the ledger line\\ 10 SKU-A paid, due Day 4};
  \node[kick, anchor=north west] (win) at ([yshift=-2mm]r3.south west) {window: 128k tokens};
  % the window meter: the input fill is 80/128 of the bar, and the bar ends level with the ghost row of the band
  \path (win.south -| r1.west) ++(0,-0.1) coordinate (mNW) (old.south -| r1.east) coordinate (mSE);
  \path ($(mNW)!0.625!(mNW -| mSE)$) coordinate (mSplit) ($(mNW)!0.5!(mSE)$) coordinate (winC);
  \draw[lane, fill=white] (mNW) rectangle (mSE);
  \begin{scope}
    \clip[rounded corners=2pt] (mNW) rectangle (mSE);
    \fill[deckNavy] (mNW) rectangle (mSplit |- mSE);
  \end{scope}
  \draw[lane] (mNW) rectangle (mSE);
  \node[bold, text=white, anchor=base east] at ($(mSplit |- winC)+(-0.12,-0.1)$) {input 80k};
  \node[kick, anchor=base west] at ($(mSplit |- winC)+(0.12,-0.1)$) {output};
  \path (r1.east) ++(0.2,0) coordinate (ctxE);
  \begin{scope}[on background layer]
    \node[mnode, inner sep=0pt, fit={(\xP,0 |- bandS) (ctxE |- 0,\yT)}] (ctx) {};
  \end{scope}
  \node[tab] at (ctx.center |- 0,\yT) {the call's context};
  % ---- connector 1: the ledger line is selected into the context
  \draw[flow] (ledger.east) -| (\xV,0 |- r3.west) -- (r3.west);
  \node[evnum] at ($(\xV,0 |- ledger.east)!0.5!(\xV,0 |- r3.west)$) {1};
  % ---- stage 2: the call and the decision. The decision is placed on every stage and drawn from stage 2,
  % so the ghost model of stage 1 stands where the model will stand.
  \path (ctx.east |- r1.east) coordinate (ctxR);
  \ifnum\stage<2 \def\decop{0}\else\def\decop{1}\fi
  \node[gnode, call, anchor=east, text width=27.5mm, align=flush center, opacity=\decop] (dec) at (16.45,0 |- ctxR)
    {next action\\ order more SKU-A?};
  \path ($(ctxR)!0.5!(dec.west)$) coordinate (mC);
  \onlystage{1}{\node[gnode, ghostbox, call, text=ibmfg!50] (model) at (mC) {model};}
  \atstage{2}{
    \node[mnode, call] (model) at (mC) {model};
    \draw[flow] (ctxR) -- (model.west);
    \node[evnum] (e2) at ($(ctxR)!0.5!(model.west)$) {2};
    \node[lab, fill=none, anchor=south] at ($(e2.north)+(0,0.04)$) {one call};
    \draw[flow] (model.east) -- (dec.west);
    \node[evnum] (e3) at ($(model.east)!0.5!(dec.west)$) {3};
    \node[lab, fill=none, anchor=south] at ($(e3.north)+(0,0.04)$) {decides};
    \node[need] (n1) at ([yshift=-6mm]dec.south) {the paid order};
    \node[need] (n2) at ([yshift=-2mm]n1.south) {meaning intact};
    \node[need] (n3) at ([yshift=-2mm]n2.south) {a route to the ledger};
    \draw[flow] (dec.south) -- (n1.north);
    \node[lab, fill=none, anchor=west] at ($(dec.south)!0.5!(n1.north)+(0.25,0)$) {it needs};
  }
  % ---- stage 3: the run meter, reserved as ghosts on stages 1 and 2
  \ifnum\stage<3
    \node[meter box, ghostbox, text=ibmfg!50] (billed) at (0,\yMlo/2+\yMhi/2) {tokens billed across the run};
    \draw[ghostbox] (\xP,\yMlo) rectangle (\xMe,\yMhi);
  \else
    \node[meter box] (billed) at (0,\yMlo/2+\yMhi/2) {tokens billed across the run};
    \fill[deckNavy, rounded corners=2pt] (\xP,\yMlo) rectangle (\xMe,\yMhi);
    \node[bold, text=white] at ($(\xP,\yMlo)!0.5!(\xMe,\yMhi)$) {the context is sent again on every call};
    \foreach \k in {1,...,5}{
      \pgfmathsetmacro\xk{\xP+\k*(\xMe-\xP)/6}
      \fill[ibmblue] (\xk,\yMlo) circle (0.065);
      \node[tick lab] at (\xk,0.1) {call \k};
    }
    \node[tick lab, text=deckGrey] at ({\xP+5.5*(\xMe-\xP)/6},0.1) {\dots};
    \node[verd, anchor=east, inner sep=0pt] at (16.45,\yMlo/2+\yMhi/2) {the run is what we pay for};
  \fi
  \node[note, anchor=north east, inner sep=0pt] at (16.45,\yT+0.208) {token counts illustrative};
\end{tikzpicture}

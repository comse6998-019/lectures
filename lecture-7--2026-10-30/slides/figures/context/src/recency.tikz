% recency: keep the last turns, drop the older ones (Slide 7.4a). Canvas 16.5 x 5.6 cm. Three stages.
% Stage 1: reveal eight turns of the run in time order and the window over the first five.
% Stage 2: the window moves on: turns 6 and 7 enter, turns 1 and 2 fade out.
% Stage 3: the window moves again: turn 8 enters, turn 3 fades. The paid order and its due date are gone (rose).
%          The cheapest strategy forgets the oldest commitment first (navy).
% Illustrative, not from a source: the turns and the window of five.
\begin{tikzpicture}
  \canvas{16.5}{5.6}
  \tikzset{turn/.style={slot, text width=16mm, align=center, minimum height=9mm}}
  \def\yt{3.6}
  % the eight turns, with the ones outside the window faded
  \foreach \i/\txt in {1/{Day 1\\ order 10},2/{Day 1\\ paid},3/{Day 1\\ due Day 4},4/{Day 2\\ shelf empty},5/{Day 2\\ wait},6/{Day 3\\ shelf empty},7/{Day 3\\ no sales},8/{Day 3\\ next?}}{
    \pgfmathsetmacro{\x}{1.1+(\i-1)*1.95}
    % stages 1, 2, 3: the window starts at turn 1, 3, 4
    \ifnum\stage=1 \def\first{1}\fi
    \ifnum\stage=2 \def\first{3}\fi
    \ifnum\stage=3 \def\first{4}\fi
    \pgfmathtruncatemacro{\last}{\first+4}
    \ifnum\i<\first
      \node[turn, faded] (t\i) at (\x,\yt) {\txt};
    \else
      \ifnum\i>\last
        \node[ghost, text width=16mm, align=center, minimum height=9mm, font=\sffamily\footnotesize] (t\i) at (\x,\yt) {\txt};
      \else
        \node[turn] (t\i) at (\x,\yt) {\txt};
      \fi
    \fi
    \node[kick, font=\sffamily\scriptsize] at (\x,\yt-0.88) {turn \i};
  }
  % the window
  \ifnum\stage=1 \draw[hl] (0.1,3.0) rectangle (9.9,4.3); \node[capt, anchor=south west] at (0.15,4.45) {the window: the last five turns};\fi
  \ifnum\stage=2 \draw[hl] (4.0,3.0) rectangle (13.8,4.3); \node[capt, anchor=south west] at (4.05,4.45) {the window moved on: turns 6 and 7 came in};\fi
  \ifnum\stage=3 \draw[hl] (5.95,3.0) rectangle (15.75,4.3); \node[capt, anchor=south west] at (6.0,4.45) {the window moved again: turn 8 came in};\fi
  \draw[-{Stealth[length=2mm]}, thick, ibmfg!30] (0.1,2.2) -- (16.4,2.2);
  \node[kick, anchor=north east] at (16.3,2.15) {time};
  \node[kick, anchor=north west] at (0.2,5.5) {eight turns of the run, newest on the right};
  \atstage{2}{\node[note, anchor=west] at (0.15,1.6) {no extra call, no extra tokens: the window just moves};}
  \atstage{3}{
    \node[badverd, anchor=west] at (0.15,1.1) {the paid order and its due date fell out of the window};
    \node[verd, anchor=west] at (0.15,0.55) {the cheapest strategy forgets the oldest commitment first};
  }
\end{tikzpicture}

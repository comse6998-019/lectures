% structured-notes: a running state card keeps commitments by design (Slide 7.4d). Canvas 16.5 x 6.0 cm. Three stages.
% Stage 1: reveal the card with its schema (goal, open orders, observations, next check) and the Day 1 step that fills
%          the goal and the open order.
% Stage 2: reveal Days 2 and 3: each step updates the observations and the next check. The order line stays.
% Stage 3: reveal the compaction boundary and Day 4. The steps fade: the history is gone. The card stays, so the
%          open order survives by design (navy). What the schema never asked for is gone with the history (rose).
% Illustrative, not from a source: the card schema and the entries. Pi's fixed summary sections and Codex's memories
% are structured notes of this kind (Slides 7.5a and 7.5c).
\begin{tikzpicture}
  \canvas{16.5}{6.0}
  \tikzset{
    runstep/.style={mnode, text width=28mm, align=left, font=\sffamily\footnotesize, anchor=west},
    field/.style={slot, text width=86mm, anchor=north west},
  }
  % the card
  \node[rnode, anchor=south west, minimum width=96mm, minimum height=44mm] (card) at (6.4,1.0) {};
  \node[anchor=west, fill=black!6, inner sep=2pt, font=\sffamily\small\bfseries] at ($(card.north west)+(0.15,0)$) {task state card};
  \node[field] (f1) at (6.55,5.05) {\textbf{goal:} keep SKU-A stocked at a profit};
  \node[field] (f2) at (6.55,4.2) {\textbf{open orders:} 10 SKU-A, paid Day 1, due Day 4};
  \ifnum\stage<2
    \node[field, text=ibmfg!40] (f3) at (6.55,3.35) {\textbf{observations:} none yet};
    \node[field, text=ibmfg!40] (f4) at (6.55,2.5) {\textbf{next check:} none yet};
  \else
    \node[field] (f3) at (6.55,3.35) {\textbf{observations:} shelf empty on Days 2 and 3, no sales};
    \node[field] (f4) at (6.55,2.5) {\textbf{next check:} did the order arrive on Day 4?};
  \fi
  % the steps on the left
  \newcommand{\stepnode}[4]{\node[runstep, #1] (#2) at (0.3,#3) {#4};}
  \beforestage{3}{
    \stepnode{}{s1}{4.85}{\textbf{Day 1} order placed, paid}
    \draw[flow] (s1.east) -- ++(0.5,0) |- (f2.west);
    \node[lab, fill=none, anchor=south west] at (3.95,4.45) {writes};
  }
  \atstage{3}{\stepnode{faded}{s1}{4.85}{\textbf{Day 1} order placed, paid} \draw[fadedflow] (s1.east) -- ++(0.5,0) |- (f2.west);}
  \atstage{2}{
    \beforestage{3}{
      \stepnode{}{s2}{3.9}{\textbf{Day 2} shelf empty}
      \stepnode{}{s3}{2.95}{\textbf{Day 3} shelf empty, no sales}
      \draw[flow] (s2.east) -- ++(0.5,0) |- (f3.west);
      \draw[flow] (s3.east) -- ++(0.7,0) |- (f4.west);
      \node[lab, fill=none, anchor=south west] at (3.95,3.5) {updates};
    }
  }
  \atstage{3}{
    \stepnode{faded}{s2}{3.9}{\textbf{Day 2} shelf empty}
    \stepnode{faded}{s3}{2.95}{\textbf{Day 3} shelf empty, no sales}
    \draw[fadedflow] (s2.east) -- ++(0.5,0) |- (f3.west);
    \draw[fadedflow] (s3.east) -- ++(0.7,0) |- (f4.west);
    \draw[deckRose, dashed, line width=1.2pt] (0.2,2.35) -- (5.9,2.35);
    \node[badverd, anchor=north west] at (0.3,2.12) {compaction: the steps above are gone};
    \stepnode{}{s4}{1.3}{\textbf{Day 4} decide: order more?}
    \draw[flow] (s4.east) -- (card.west |- s4);
    \node[lab, fill=none, anchor=south west] at (3.95,1.35) {reads the card};
    \node[verd, anchor=west] at (6.55,0.55) {the open order survives by design: the schema asked for it};
    \node[badverd] at (11.2,1.5) {what the schema never asked for is gone with the history};
  }
  \node[note, anchor=north east, inner sep=0pt] at (16.4,5.95) {illustrative card};
\end{tikzpicture}

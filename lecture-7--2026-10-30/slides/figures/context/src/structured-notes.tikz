% structured-notes: a running state card keeps commitments by design (Slide 7.4d). Canvas 16.5 x 6.2 cm. Three stages.
% Stage 1: reveal the card with its schema (goal, open orders, observations, next check) and the Day 1 step that
%          writes the open order.
% Stage 2: reveal Days 2 and 3: one writes the observations, the other the next check. The order line stays.
% Stage 3: reveal the compaction boundary and Day 4. The steps fade: the history is gone. The card stays, so the
%          open order survives by design (navy). What the schema never asked for is gone with the history (rose).
% Illustrative, not from a source: the card schema and the entries. Pi's fixed summary sections and Codex's memories
% are structured notes of this kind (Slides 7.5a and 7.5c).
\begin{tikzpicture}
  \canvas{16.5}{6.2}
  \tikzset{
    runstep/.style={mnode, text width=30mm, align=left, font=\sffamily\footnotesize, anchor=west, minimum height=8mm},
    field/.style={slot, text width=86mm, anchor=west, minimum height=8mm},
  }
  % the card: each field centred on its row, so every connector is one straight line
  \def\yA{5.3}\def\yB{4.4}\def\yC{3.5}\def\yD{2.6}
  \node[rnode, anchor=south west, minimum width=96mm, minimum height=38mm] (card) at (6.4,2.05) {};
  \node[tab] at (card.north) {task state card};
  \node[field] (f1) at (6.55,\yA) {\textbf{goal:} keep SKU-A stocked at a profit};
  \node[field] (f2) at (6.55,\yB) {\textbf{open orders:} 10 SKU-A, paid Day 1, due Day 4};
  \ifnum\stage<2
    \node[field, text=ibmfg!40] (f3) at (6.55,\yC) {\textbf{observations:} none yet};
    \node[field, text=ibmfg!40] (f4) at (6.55,\yD) {\textbf{next check:} none yet};
  \else
    \node[field] (f3) at (6.55,\yC) {\textbf{observations:} shelf empty on Days 2 and 3, no sales};
    \node[field] (f4) at (6.55,\yD) {\textbf{next check:} did the order arrive on Day 4?};
  \fi
  % the steps on the left, one per row, each with one straight connector into its field
  \newcommand{\stepnode}[4]{\node[runstep, #1] (#2) at (0.3,#3) {#4};}
  \beforestage{3}{
    \stepnode{}{s1}{\yB}{\textbf{Day 1} order placed, paid}
    \draw[flow] (s1.east) -- (f2.west);
    \node[lab, fill=none, anchor=south] at (5.1,\yB+0.08) {writes};
  }
  \atstage{3}{\stepnode{faded}{s1}{\yB}{\textbf{Day 1} order placed, paid} \draw[fadedflow] (s1.east) -- (f2.west);}
  \atstage{2}{
    \beforestage{3}{
      \stepnode{}{s2}{\yC}{\textbf{Day 2} shelf empty}
      \stepnode{}{s3}{\yD}{\textbf{Day 3} shelf empty, no sales}
      \draw[flow] (s2.east) -- (f3.west);
      \draw[flow] (s3.east) -- (f4.west);
      \node[lab, fill=none, anchor=south] at (5.1,\yC+0.08) {writes};
      \node[lab, fill=none, anchor=south] at (5.1,\yD+0.08) {writes};
    }
  }
  \atstage{3}{
    \stepnode{faded}{s2}{\yC}{\textbf{Day 2} shelf empty}
    \stepnode{faded}{s3}{\yD}{\textbf{Day 3} shelf empty, no sales}
    \draw[fadedflow] (s2.east) -- (f3.west);
    \draw[fadedflow] (s3.east) -- (f4.west);
    \draw[deckRose, dashed, line width=1.2pt] (0.2,1.95) -- (6.2,1.95);
    \node[badverd, anchor=west] at (0.3,1.7) {compaction: the steps are gone, and so is what the schema never asked for};
    \stepnode{}{s4}{0.75}{\textbf{Day 4} decide: order more?}
    \draw[flow] (s4.east) -- (11.2,0.75) -- (card.south);
    \node[lab, fill=none, anchor=south] at (7.4,0.85) {reads the card};
    \node[verd, anchor=west] at (11.5,1.3) {the open order survives by design:\\ the schema asked for it};
  }
  \node[note, anchor=north east, inner sep=0pt] at (16.4,6.15) {illustrative card};
\end{tikzpicture}
